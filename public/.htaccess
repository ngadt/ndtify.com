# ===== NDTify – Apache config for Namecheap shared hosting =====

# Force HTTPS
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# www.ndtify.com -> ndtify.com (canonical host)
RewriteCond %{HTTP_HOST} ^www\.ndtify\.com$ [NC]
RewriteRule ^(.*)$ https://ndtify.com/$1 [R=301,L]

# NOTE: public_html is shared with other sites' document roots, so every rewrite
# below is limited to the ndtify.com host.

# Canonical URLs: /index.html -> /  and  /work/x/index.html -> /work/x/
RewriteCond %{HTTP_HOST} ^(www\.)?ndtify\.com$ [NC]
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]

# Old one-page anchors that people may have bookmarked
RewriteCond %{HTTP_HOST} ^(www\.)?ndtify\.com$ [NC]
RewriteRule ^products/?$ /work/ [R=301,L]
RewriteCond %{HTTP_HOST} ^(www\.)?ndtify\.com$ [NC]
RewriteRule ^pricing/?$ /services/ [R=301,L]

# Custom 404 page
ErrorDocument 404 /404.html
DirectoryIndex index.html index.php

# Serve .webp / .svg with correct MIME types
AddType image/webp .webp
AddType image/svg+xml .svg

# Gzip / Brotli compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Browser caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType application/xml "access plus 1 day"
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Hide directory listings
Options -Indexes
