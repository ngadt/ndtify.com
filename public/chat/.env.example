# Copy to .env.local and fill in. .env.local is git-ignored and blocked from the web.
NDT_TG_BOT_TOKEN=123456:ABC-your-bot-token
NDT_TG_CHAT_ID=-1001234567890
NDT_TG_WEBHOOK_SECRET=any-long-random-string
NDT_SETUP_KEY=another-long-random-string
# Optional: where contact-form requests are emailed (default support@ndtify.com)
# NDT_CONTACT_EMAIL=support@ndtify.com
